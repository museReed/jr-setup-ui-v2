{
  "_note": "Windows 專用的補充規則，跟 starter-allowlist.json 疊加使用，不是取代它。Windows 上兩條路都在（Bash / PowerShell），模型自己選——只發一邊等於一半的呼叫仍然會跳提示。",
  "permissions": {
    "allow": [
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(ls:*)",
      "PowerShell(dir:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(cat:*)",
      "PowerShell(type:*)",
      "PowerShell(Select-Object:*)",
      "PowerShell(Measure-Object:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Get-Location:*)",
      "PowerShell(pwd)",
      "PowerShell(Get-Command:*)",
      "PowerShell(where.exe:*)",
      "PowerShell(Compare-Object:*)",
      "PowerShell(Sort-Object:*)",
      "PowerShell(Write-Output:*)",
      "PowerShell(echo:*)",
      "PowerShell(Write-Host:*)",
      "PowerShell(Get-Date:*)",
      "PowerShell(jq:*)",
      "PowerShell(Set-Location:*)",
      "PowerShell(cd:*)",
      "PowerShell(New-Item:*)",
      "PowerShell(mkdir:*)",
      "PowerShell(Copy-Item:*)",
      "PowerShell(cp:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(mv:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git show:*)",
      "PowerShell(git remote:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git init:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npm list:*)",
      "PowerShell(node --version:*)",
      "PowerShell(npm --version:*)"
    ]
  }
}
